generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MKT
  NOC
  FOC
  GA // General Affair + Procurement (satu peran)
  FIN
}

enum SubRole {
  MANAGER
  SUPERVISOR
  STAFF
}

enum WoType {
  NEW_INSTALL
  TROUBLE
  SUSPEND
  UNSUSPEND
  TERMINATE
  STOCK_REQUEST
  STOCK_RETURN // serah-terima sisa material teknisi → gudang
  MAINTENANCE // maintenance / troubleshoot mandiri (bukan dari tiket), ditugaskan supervisor/manager FOC
}

enum CustomerStatus {
  PROSPECT
  INSTALLING
  ACTIVE
  SUSPENDED
  TERMINATING
  TERMINATED
}

enum ItemCategory {
  CONSUMABLE // kuantitas / meter
  NETWORK // wajib serial number
  GA // aset general, kode aset + jadwal maintenance
}

enum WarehouseKind {
  MAIN
  BRANCH
  TRANSIT
  MOBILE // mobile stock teknisi / mobil
}

enum AssetStatus {
  IN_STOCK
  INSTALLED
  IN_USE // aset GA yang sedang dipakai
  RETURNED_PENDING_QC
  REFURBISHED // siap pakai kembali
  DAMAGED
  SCRAP
}

enum NotifChannel {
  EMAIL
  TELEGRAM
  WHATSAPP
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  subRole            SubRole  @default(STAFF) // saat ini hanya membedakan hak FOC (jadwal = supervisor/manager)
  telegramChatId     String?
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  avatarUrl          String? // foto profil (diunggah pengguna sendiri)
  createdAt          DateTime @default(now())

  created          WorkOrder[]       @relation("creator")
  assigned         WorkOrder[]       @relation("assignee")
  warehouse        Warehouse[]
  inbox            Inbox[]
  purchaseRequests PurchaseRequest[]
  subscriptions    Subscription[]
}

model Customer {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  phone          String
  email          String?
  address        String
  lat            Float?
  lng            Float?
  packageName    String
  status         CustomerStatus @default(PROSPECT)
  warehouseId    String? // gudang yang melayani area pelanggan (diturunkan dari Area)
  areaId         String?
  odp            String?
  port           String?
  pop            String? // POP (titik kehadiran jaringan) yang melayani pelanggan, diisi FOC saat validasi
  vlan           String?
  ip             String?
  publicIp       String? // IP publik (opsional); dicek duplikat hanya bila terisi
  source         String         @default("MANUAL") // MANUAL | RADIUS (bersumber dari MSRadius, hanya dibaca)
  radiusName     String? // nama akun apa adanya dari MSRadius
  radiusIp       String? // IP statis dari MSRadius (rujukan NOC; tidak menggantikan IP internal)
  expiredAt      DateTime?
  resellerName   String?
  salesName      String?
  radiusStatus   String? // status layanan dari MSRadius: WAITING | ONLINE | OFFLINE | ISOLIR | DISABLE (apa adanya dari API)
  missingFromApi Boolean        @default(false) // tidak ada lagi di MSRadius pada sinkron terakhir (tidak dihapus otomatis)
  syncedAt       DateTime?
  activatedAt    DateTime?
  createdAt      DateTime       @default(now())
  archivedAt     DateTime? // diarsipkan (dihapus dari daftar tetapi riwayat WO tetap utuh); Admin dapat memulihkan

  warehouse  Warehouse?  @relation(fields: [warehouseId], references: [id])
  area       Area?       @relation(fields: [areaId], references: [id])
  workOrders WorkOrder[]
  assets     Asset[]

  @@index([areaId])
  @@index([status])
  @@index([radiusStatus])
  @@index([archivedAt])
  @@index([publicIp])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_code_trgm")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_phone_trgm")
  @@index([ip(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_ip_trgm")
}

model WorkOrder {
  id          String    @id @default(cuid())
  number      String    @unique
  type        WoType
  status      String
  title       String
  customerId  String?
  createdById String
  assigneeId  String? // teknisi utama (anggota pertama tim)
  teamIds     String[]  @default([]) // seluruh tim pelaksana (termasuk teknisi utama); siapa pun di tim boleh mengirim laporan
  parentId    String?
  data        Json      @default("{}")
  scheduledAt DateTime?
  source      String    @default("APP") // APP | BILLING
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?

  customer         Customer?         @relation(fields: [customerId], references: [id])
  createdBy        User              @relation("creator", fields: [createdById], references: [id])
  assignee         User?             @relation("assignee", fields: [assigneeId], references: [id])
  parent           WorkOrder?        @relation("child", fields: [parentId], references: [id])
  children         WorkOrder[]       @relation("child")
  events           WoEvent[]
  attachments      Attachment[]
  purchase         PurchaseOrder[]
  purchaseRequests PurchaseRequest[]

  @@index([type, status])
  @@index([customerId])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([closedAt, createdAt])
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "WorkOrder_number_trgm")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "WorkOrder_title_trgm")
}

model WoEvent {
  id           String   @id @default(cuid())
  woId         String
  action       String
  fromStatus   String?
  toStatus     String
  actorId      String?
  actorName    String?
  actorRole    String?
  actorSubRole String?
  note         String?
  payload      Json?
  createdAt    DateTime @default(now())

  wo WorkOrder @relation(fields: [woId], references: [id], onDelete: Cascade)

  @@index([woId, createdAt])
}

model Attachment {
  id         String    @id @default(cuid())
  woId       String?
  url        String
  mime       String
  uploadedBy String
  kind       String    @default("REPORT") // REPORT | PROGRESS | LOGO
  lat        Float? // GPS saat foto diambil
  lng        Float?
  accuracy   Float? // meter
  takenAt    DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  wo WorkOrder? @relation(fields: [woId], references: [id])
}

model Warehouse {
  id      String        @id @default(cuid())
  code    String        @unique
  name    String
  kind    WarehouseKind
  ownerId String? // pemilik mobile stock (teknisi)
  address String?
  active  Boolean       @default(true)

  owner     User?        @relation(fields: [ownerId], references: [id])
  stock     StockLevel[]
  assets    Asset[]
  customers Customer[]
  areas     Area[]
}

model Item {
  id                String       @id @default(cuid())
  sku               String       @unique
  name              String
  category          ItemCategory
  unit              String       @default("pcs")
  tracked           Boolean      @default(false) // true = per serial number
  installDefaultQty Int? // kebutuhan standar 1x pasang baru (untuk cek stok otomatis)
  minStock          Int          @default(0)
  coreCount         Int? // khusus kabel: jumlah core (terisi = item kabel, satuan meter)
  isVehicle         Boolean      @default(false) // kendaraan: form aset menampilkan plat & no. rangka

  stock   StockLevel[]
  assets  Asset[]
  poLines PoLine[]
  prLines PrLine[]
}

model StockLevel {
  id          String @id @default(cuid())
  warehouseId String
  itemId      String
  qty         Int    @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
}

model Asset {
  id                      String      @id @default(cuid())
  itemId                  String
  serialNumber            String      @unique
  assetCode               String?     @unique
  status                  AssetStatus @default(IN_STOCK)
  warehouseId             String?
  customerId              String?
  woId                    String?
  condition               String?
  notes                   String?
  needsMaintenance        Boolean     @default(false) // aset yang perlu perawatan berkala (muncul di dasbor)
  maintenanceIntervalDays Int?
  plateNumber             String?
  chassisNumber           String?
  nextMaintenanceAt       DateTime?
  lastMaintenanceAt       DateTime?
  createdAt               DateTime    @default(now())
  brandId                 String?
  modelId                 String?

  item      Item        @relation(fields: [itemId], references: [id])
  warehouse Warehouse?  @relation(fields: [warehouseId], references: [id])
  customer  Customer?   @relation(fields: [customerId], references: [id])
  brand     AssetBrand? @relation(fields: [brandId], references: [id])
  model     AssetModel? @relation(fields: [modelId], references: [id])

  @@index([status])
  @@index([warehouseId])
  @@index([customerId])
  @@index([createdAt])
  @@index([itemId, status])
  @@index([serialNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Asset_serial_trgm")
  @@index([assetCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "Asset_code_trgm")
}

model StockMovement {
  id              String   @id @default(cuid())
  itemId          String
  assetId         String?
  qty             Int
  fromWarehouseId String?
  toWarehouseId   String?
  reason          String
  woId            String?
  actorId         String?
  createdAt       DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([woId])
}

model PurchaseOrder {
  id            String    @id @default(cuid())
  number        String    @unique
  vendor        String
  status        String    @default("ISSUED") // ISSUED | PARTIAL | RECEIVED
  woId          String?
  toWarehouseId String
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())
  prId          String? // Purchase Request asal (PO diterbitkan di Accurate, dicatat ulang di sini)
  vendorId      String?
  poDate        DateTime?
  taxPct        Decimal?  @db.Decimal(5, 2)

  wo        WorkOrder?       @relation(fields: [woId], references: [id])
  pr        PurchaseRequest? @relation(fields: [prId], references: [id])
  vendorRef Vendor?          @relation(fields: [vendorId], references: [id])
  lines     PoLine[]

  @@index([prId])
}

model PoLine {
  id          String   @id @default(cuid())
  poId        String
  itemId      String
  qty         Int
  receivedQty Int      @default(0)
  unitPrice   Decimal? @db.Decimal(18, 2)
  description String?

  po     PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item   Item          @relation(fields: [itemId], references: [id])
  prLine PrLine?
}

model Notification {
  id        String       @id @default(cuid())
  woId      String?
  userId    String?
  channel   NotifChannel
  target    String
  subject   String
  body      String
  status    String       @default("PENDING") // PENDING | SENT | FAILED
  error     String?
  createdAt DateTime     @default(now())
  sentAt    DateTime?
  // WhatsApp via Kanca: id broadcast + status delivery dari Meta (sent/delivered/read/failed), diperbarui poller & webhook
  providerRef    String?
  providerStatus String?
  providerMsgId  String? // wamid dari Meta (dicocokkan dengan event webhook)

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([providerRef])
  @@index([providerMsgId])
}

// Pencatatan template WhatsApp (Kanca): UUID dari tombol "copy" di dashboard Kanca atau hasil sinkron GET /templates
model WaTemplate {
  id         String   @id @default(cuid())
  templateId String   @unique // UUID template di Kanca
  name       String
  category   String? // UTILITY | AUTHENTICATION | MARKETING
  status     String? // APPROVED | PENDING | REJECTED (dari Kanca / diisi manual)
  body       String? // isi template ({{1}}, {{2}}) untuk pratinjau
  varCount   Int      @default(1)
  purpose    String? // catatan pemakaian, mis. "notifikasi WO", "BA"
  source     String   @default("manual") // manual | kanca
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Log event webhook Kanca (idempoten per X-Kanca-Delivery-Id); dibersihkan otomatis >30 hari
model KancaEvent {
  id         String   @id @default(cuid())
  deliveryId String?  @unique
  event      String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// Event keluar ke aplikasi billing/finance eksisting (webhook bertanda tangan HMAC)
model OutboundEvent {
  id        String    @id @default(cuid())
  event     String
  payload   Json
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// Pengaturan yang dikelola Admin dari UI (smtp, telegram, branding, app). Rahasia disimpan terenkripsi.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Master merk & tipe perangkat (pilihan saat registrasi aset)
model AssetBrand {
  id     String       @id @default(cuid())
  name   String       @unique
  models AssetModel[]
  assets Asset[]
}

model AssetModel {
  id      String     @id @default(cuid())
  brandId String
  name    String
  brand   AssetBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  assets  Asset[]

  @@unique([brandId, name])
}

// Master nama paket / jasa langganan
model Package {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  source      String   @default("MANUAL") // MANUAL | RADIUS
  speed       String?
  priceSell   Decimal? @db.Decimal(18, 2)
}

// Jejak audit: ubah/hapus/reset password/impor
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  role      String
  action    String // CREATE | UPDATE | DELETE | PASSWORD_RESET | IMPORT
  entity    String
  entityId  String?
  summary   String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// Kotak masuk notifikasi dalam aplikasi (lonceng): satu baris per pengguna per kejadian, terpisah dari pengiriman email/Telegram.
model Inbox {
  id        String    @id @default(cuid())
  userId    String
  subject   String
  body      String
  woId      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // hapus user → kotak masuknya ikut terhapus
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

/**
 * ── Pengadaan: master vendor, Purchase Request (perbandingan harga), PO dari Accurate ──
 */
model Vendor {
  id          String   @id @default(cuid())
  name        String   @unique
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  quotes PrQuote[]
  pos    PurchaseOrder[]
}

model PurchaseRequest {
  id                 String    @id @default(cuid())
  number             String?   @unique // nomor surat, dibuat saat PDF diterbitkan, mis. 250/L1V/PNJ-BDG/X/2026
  status             String    @default("DRAFT") // DRAFT | ISSUED | APPROVED | REJECTED | PO_ENTERED | CLOSED | CANCELLED
  subject            String // Perihal
  city               String    @default("Bandung")
  docDate            DateTime?
  taxPct             Decimal   @default(11) @db.Decimal(5, 2)
  note               String?
  woId               String? // Permintaan Barang (WO) asal, bila ada
  areaId             String? // area pengaju: singkatan area dipakai pada nomor surat (L1V/PNJ-{ALIAS})
  createdById        String
  signRequester      String? // Mengajukan (diisi procurement saat menerbitkan PDF)
  signRequesterTitle String?
  signKnow           String? // Mengetahui
  signKnowTitle      String?
  signApprove        String? // Menyetujui
  signApproveTitle   String?
  issuedAt           DateTime?
  approvedAt         DateTime?
  approvalRef        String? // no. PR/persetujuan di sistem lain (Accurate)
  approvalNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy User            @relation(fields: [createdById], references: [id])
  wo        WorkOrder?      @relation(fields: [woId], references: [id])
  area      Area?           @relation(fields: [areaId], references: [id])
  lines     PrLine[]
  pos       PurchaseOrder[]

  @@index([status, createdAt])
  @@index([createdById])
}

model PrLine {
  id          String  @id @default(cuid())
  prId        String
  sort        Int     @default(0)
  description String
  qty         Int
  unit        String  @default("Unit")
  itemId      String? // terhubung ke master item = barang stok (masuk gudang); kosong = non-stok/jasa
  note        String? // Keterangan (tabel perbandingan)
  poLineId    String? @unique // diisi saat PO dicatat

  pr     PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  item   Item?           @relation(fields: [itemId], references: [id])
  poLine PoLine?         @relation(fields: [poLineId], references: [id])
  quotes PrQuote[]

  @@index([prId])
}

model PrQuote {
  id        String  @id @default(cuid())
  lineId    String
  vendorId  String
  unitPrice Decimal @db.Decimal(18, 2)
  note      String?
  chosen    Boolean @default(false)

  line   PrLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([lineId, vendorId])
}

/// Riwayat sinkron dari MSRadius (baca-saja)
// Riwayat perubahan data pelanggan dari sinkron MSRadius (nilai lama tidak hilang saat data diperbarui)
model CustomerChange {
  id         String   @id @default(cuid())
  customerId String
  field      String // name | phone | address | packageName | status | expiredAt | ... | missingFromApi | * (dibuat)
  oldValue   String?
  newValue   String?
  source     String   @default("RADIUS") // RADIUS | APP
  syncRunId  String?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([syncRunId])
}

model SyncRun {
  id         String    @id @default(cuid())
  trigger    String // MANUAL | AUTO | TEST
  status     String    @default("RUNNING") // RUNNING | OK | ERROR
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  created    Int       @default(0)
  updated    Int       @default(0)
  unchanged  Int       @default(0)
  skipped    Int       @default(0)
  missing    Int       @default(0)
  packages   Int       @default(0)
  areas      Int       @default(0)
  forms      Int       @default(0)
  error      String?
  userId     String?

  @@index([startedAt])
}

/// Area layanan (master dari MSRadius `masterdata/area/list` atau manual); tiap area dilayani satu gudang.
model Area {
  id          String   @id @default(cuid())
  code        String?  @unique // id_area di MSRadius
  name        String   @unique
  warehouseId String?
  alias       String? // singkatan area untuk nomor dokumen, mis. BDG, BGR
  source      String   @default("MANUAL") // MANUAL | RADIUS
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  customers Customer[]
  prs       PurchaseRequest[]
}

/// Formulir Berlangganan digital (diterbitkan Marketing, dicetak untuk ditandatangani pelanggan)
model Subscription {
  id            String   @id @default(cuid())
  regNo         String   @unique // awalan + 3 digit tahun (mis. SM026) + nomor isian
  formDate      DateTime @default(now())
  name          String?
  address       String?
  phone         String?
  email         String?
  referral      String?
  packageName   String?
  serviceNote   String?
  installFee    Decimal? @db.Decimal(18, 2)
  monthlyFee    Decimal? @db.Decimal(18, 2)
  picName       String?
  picPhone      String?
  payment       String   @default("TRANSFER") // CASH | TRANSFER | DEBIT
  marketingName String?
  managerName   String?
  createdById   String
  customerId    String?
  woId          String?
  source        String   @default("MANUAL") // MANUAL | RADIUS (dibuat otomatis dari pelanggan berstatus Waiting di MSRadius)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@index([name])
}
