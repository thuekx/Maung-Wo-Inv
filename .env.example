# Salin ke .env (root, dipakai docker compose) dan apps/api/.env (jika dev lokal)
NODE_ENV=development
POSTGRES_PASSWORD=ganti_password_kuat
JWT_SECRET=ganti_dengan_string_acak_panjang
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dev lokal tanpa docker (apps/api/.env)
DATABASE_URL=postgresql://l1v:l1v_dev_pw@localhost:5432/l1v_wo
REDIS_URL=redis://localhost:6379

# Email (kosongkan SMTP_HOST = mode dry-run, hanya log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="L1V WO <noreply@perusahaan.co.id>"

# Telegram (kosongkan token = mode dry-run)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=ganti_secret_webhook
# Grup Telegram per divisi (opsional) – chat id grup
# Grup Telegram per divisi (opsional), contoh: {"NOC":"-100123","FOC":"-100456"}
TELEGRAM_ROLE_CHATS='{}'

# Export API baca-saja (docs/API.md). Kosong = nonaktif. Buat: openssl rand -hex 24
EXPORT_API_KEY=

# Integrasi Billing (opsional; Finance saat ini hanya pengingat Telegram/email)
BILLING_API_KEY=ganti_api_key_untuk_billing_memanggil_wo_app
BILLING_WEBHOOK_URL=
BILLING_WEBHOOK_SECRET=ganti_secret_hmac

# Seed
SEED_PASSWORD=Passw0rd!

# HTTPS via Caddy (opsional, diisi otomatis oleh scripts/deploy.sh --caddy)
WEB_DOMAIN=
API_DOMAIN=
